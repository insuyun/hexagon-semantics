MACROATTRIB( \
    "LIKELY", \
    """__builtin_expect((X),1)""", \
    "()" \
)
MACROATTRIB( \
    "UNLIKELY", \
    """__builtin_expect((X),0)""", \
    "()" \
)
MACROATTRIB( \
    "CANCEL", \
    """{if (thread->last_pkt) thread->last_pkt->slot_cancelled |= (1<<insn->slot); return;}""", \
    "(A_CONDEXEC)" \
)
MACROATTRIB( \
    "LOAD_CANCEL", \
    """{mem_general_load_cancelled(thread,EA,insn);CANCEL;}""", \
    "(A_CONDEXEC)" \
)
MACROATTRIB( \
    "STORE_CANCEL", \
    """{mem_general_store_cancelled(thread,EA,insn);CANCEL;}""", \
    "(A_CONDEXEC)" \
)
MACROATTRIB( \
    "fMAX", \
    """(((A) > (B)) ? (A) : (B))""", \
    "" \
)
MACROATTRIB( \
    "fMIN", \
    """(((A) < (B)) ? (A) : (B))""", \
    "" \
)
MACROATTRIB( \
    "fABS", \
    """(((A)<0)?(-(A)):(A))""", \
    "" \
)
MACROATTRIB( \
    "fINSERT_BITS", \
    """{ REG = ((REG) & ~(((fCONSTLL(1)<<(WIDTH))-1)<<(OFFSET))) | (((INVAL) & ((fCONSTLL(1)<<(WIDTH))-1)) << (OFFSET)); }""", \
    "" \
)
MACROATTRIB( \
    "fEXTRACTU_BITS", \
    """(fZXTN(WIDTH,32,(INREG >> OFFSET)))""", \
    "" \
)
MACROATTRIB( \
    "fEXTRACTU_BIDIR", \
    """(fZXTN(WIDTH,32,fBIDIR_LSHIFTR((INREG),(OFFSET),4_8)))""", \
    "" \
)
MACROATTRIB( \
    "fEXTRACTU_RANGE", \
    """(fZXTN((HIBIT-LOWBIT+1),32,(INREG >> LOWBIT)))""", \
    "" \
)
MACROATTRIB( \
    "fINSERT_RANGE", \
    """{ int offset=LOWBIT; int width=HIBIT-LOWBIT+1; INREG &= ~(((fCONSTLL(1)<<width)-1)<<offset); INREG |= ((INVAL & ((fCONSTLL(1)<<width)-1)) << offset); }""", \
    "" \
)
MACROATTRIB( \
    "f8BITSOF", \
    """( (VAL) ? 0xff : 0x00)""", \
    "" \
)
MACROATTRIB( \
    "fLSBOLD", \
    """((VAL) & 1)""", \
    "()" \
)
MACROATTRIB( \
    "fLSBNEW", \
    """predlog_read(thread,PNUM)""", \
    "()" \
)
MACROATTRIB( \
    "fLSBNEW0", \
    """predlog_read(thread,0)""", \
    "()" \
)
MACROATTRIB( \
    "fLSBNEW1", \
    """predlog_read(thread,1)""", \
    "()" \
)
MACROATTRIB( \
    "fLSBOLDNOT", \
    """(!fLSBOLD(VAL))""", \
    "()" \
)
MACROATTRIB( \
    "fLSBNEWNOT", \
    """(!fLSBNEW(PNUM))""", \
    "()" \
)
MACROATTRIB( \
    "fLSBNEW0NOT", \
    """(!fLSBNEW0)""", \
    "()" \
)
MACROATTRIB( \
    "fLSBNEW1NOT", \
    """(!fLSBNEW1)""", \
    "()" \
)
MACROATTRIB( \
    "fNEWREG", \
