    """fLOADMMV_AL(EA,fVECSIZE(),fVECSIZE(),DST)""", \
    "()" \
)
MACROATTRIB( \
    "fLOADMMVQ", \
    """do { int __i; fLOADMMV_AL(EA,fVECSIZE(),fVECSIZE(),DST); fVFOREACH(8,__i) if (!fGETQBIT(QVAL,__i)) DST.b[__i] = 0; } while (0)""", \
    "()" \
)
MACROATTRIB( \
    "fLOADMMVNQ", \
    """do { int __i; fLOADMMV_AL(EA,fVECSIZE(),fVECSIZE(),DST); fVFOREACH(8,__i) if (fGETQBIT(QVAL,__i)) DST.b[__i] = 0; } while (0)""", \
    "()" \
)
MACROATTRIB( \
    "fLOADMMVU_AL", \
    """{ size4u_t size2 = (EA)&(ALIGNMENT-1); size4u_t size1 = LEN-size2; thread->last_pkt->double_access_vec = 1; mem_load_vector_oddva(thread, insn, EA+size1, EA+fVECSIZE(), 1, size2, &DST.ub[size1], size2, fUSE_LOOKUP_ADDRESS()); mem_load_vector_oddva(thread, insn, EA, EA, 0, size1, &DST.ub[0], size1, fUSE_LOOKUP_ADDRESS_BY_REV(thread->processor_ptr)); }""", \
    "(A_LOAD,A_MEMLIKE)" \
)
MACROATTRIB( \
    "fLOADMMVU", \
    """{ thread->last_pkt->pkt_has_vtcm_access = 0; thread->last_pkt->pkt_access_count = 0; if ( (EA & (fVECSIZE()-1)) == 0) { thread->last_pkt->pkt_has_vmemu_access = 0; thread->last_pkt->double_access = 0; fLOADMMV_AL(EA,fVECSIZE(),fVECSIZE(),DST); } else { thread->last_pkt->pkt_has_vmemu_access = 1; thread->last_pkt->double_access = 1; fLOADMMVU_AL(EA,fVECSIZE(),fVECSIZE(),DST); } }""", \
    "()" \
)
