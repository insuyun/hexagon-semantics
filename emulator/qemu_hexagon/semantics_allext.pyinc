    "(A_STORE,A_MEMLIKE)" \
)
MACROATTRIB( \
    "fVFETCH_AL", \
    """{ fV_AL_CHECK(EA,fVECSIZE()-1); mem_fetch_vector(thread, insn, EA&~(fVECSIZE()-1), insn->slot, fVECSIZE()); }""", \
