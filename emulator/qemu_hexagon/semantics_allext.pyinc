    "()" \
)
MACROATTRIB( \
    "fGETQBITS", \
    """((MASK) & (REG.w[(BITNO)>>5] >> ((BITNO) & 0x1f)))""", \
    "()" \
)
MACROATTRIB( \
    "fGETQBIT", \
    """fGETQBITS(REG,1,1,BITNO)""", \
    "()" \
)
MACROATTRIB( \
    "fGENMASKW", \
    """(((fGETQBIT(QREG,(IDX*4+0)) ? 0xFF : 0x0) << 0) |((fGETQBIT(QREG,(IDX*4+1)) ? 0xFF : 0x0) << 8) |((fGETQBIT(QREG,(IDX*4+2)) ? 0xFF : 0x0) << 16) |((fGETQBIT(QREG,(IDX*4+3)) ? 0xFF : 0x0) << 24))""", \
    "()" \
)
MACROATTRIB( \
    "fGET10BIT", \
    """{ COE = (((((fGETUBYTE(3,VAL) >> (2 * POS)) & 3) << 8) | fGETUBYTE(POS,VAL)) << 6); COE >>= 6; }""", \
    "()" \
)
