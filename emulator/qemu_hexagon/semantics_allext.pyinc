)
MACROATTRIB( \
    "fLOADMMV_AL", \
    """{ fV_AL_CHECK(EA,ALIGNMENT-1); thread->last_pkt->double_access_vec = 0; mem_load_vector_oddva(thread, insn, EA&~(ALIGNMENT-1), EA, insn->slot, LEN, &DST.ub[0], LEN, fUSE_LOOKUP_ADDRESS_BY_REV(thread->processor_ptr)); }""", \
    "(A_LOAD,A_MEMLIKE)" \
)
