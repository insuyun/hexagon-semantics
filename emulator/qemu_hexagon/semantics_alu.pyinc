    """{ int slot = insn->slot; int i0; paddr_t pa = thread->mem_access[slot].paddr+OFFSET; paddr_t pa_high = thread->mem_access[slot].paddr+LEN; int log_bank = 0; int log_byte = 0; for(i0 = 0; i0 < ELEMENT_SIZE; i0++) { log_byte = ((OFFSET>=0)&&((pa+i0)<=pa_high)) && QVAL; log_bank |= (log_byte<<i0); LOG_VTCM_BYTE(pa+i0,log_byte,IN.ub[ELEMENT_SIZE*IDX+i0],ELEMENT_SIZE*IDX+i0); } LOG_VTCM_BANK(pa, log_bank,BANK_IDX); }""", \
    "()" \
)
